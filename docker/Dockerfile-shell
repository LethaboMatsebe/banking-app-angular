# ---------- Build Stage ----------
FROM node:22 AS build

WORKDIR /app

# Copy lockfile dependencies from repository root layout
COPY package*.json ./

RUN npm install

# Copy all source folders into build staging area context
COPY . .

# 🛠️ CORRECTION: Run explicit Angular CLI workspace engine compilation directly
RUN npx ng build shell --configuration=production

# ---------- Runtime Stage ----------
FROM nginx:alpine

# Copy nginx configuration profile directly from docker folder
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# 📐 CORRECTION: Target your repository output folder path "dist/shell/browser"
COPY --from=build /app/dist/shell/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
