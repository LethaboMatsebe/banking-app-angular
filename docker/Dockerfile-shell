# ---------- Build Stage ----------
FROM node:22 AS build

WORKDIR /app

# Copy lockfile dependencies from repository root
COPY ../package*.json ./

RUN npm install

# Copy all source folders into build staging area context
COPY ../ ./

RUN npx ng build shell --configuration=production

# ---------- Runtime Stage ----------
FROM nginx:alpine

# Copy nginx configuration profile directly from docker folder
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist/shell/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
