# ---------- Build Stage ----------
FROM node:22 AS build

WORKDIR /app

# Copy dependency files (must exist inside docker/)
COPY package*.json ./

RUN npm install

# Copy Angular workspace config + shell project (must exist inside docker/)
COPY angular.json ./
COPY tsconfig*.json ./
COPY projects/shell ./projects/shell

RUN npx ng build shell --configuration=production

# ---------- Runtime Stage ----------
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist/shell/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
